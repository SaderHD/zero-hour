{
  "name": "zero-hour",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "dev": "pnpm --filter @zero-hour/client dev",
    "dev:server": "pnpm --filter @zero-hour/server dev",
    "format": "biome format --write .",
    "lint": "biome check . && node tools/check-imports.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
